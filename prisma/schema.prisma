generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [citext]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model access_requests {
  id                                        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                   String?     @db.Uuid
  temporada_id                              String?     @db.Uuid
  tipo_solicitud                            String      @default("temporada") @db.VarChar(12)
  status                                    String      @default("pendiente") @db.VarChar(12)
  motivacion                                String?
  how_found                                 String?
  recomendado_por                           String?     @db.VarChar(128)
  is_adult                                  Boolean?
  revisado_por                              String?     @db.Uuid
  revisado_en                               DateTime?   @db.Timestamptz(6)
  motivo_rechazo                            String?
  created_at                                DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime    @default(now()) @db.Timestamptz(6)
  slots_permitidos                          Int         @default(1) @db.SmallInt
  users_access_requests_revisado_porTousers users?      @relation("access_requests_revisado_porTousers", fields: [revisado_por], references: [id], onUpdate: NoAction)
  temporadas                                temporadas? @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_access_requests_user_idTousers      users?      @relation("access_requests_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, temporada_id], map: "idx_ar_pendientes", where: raw("((status)::text = 'pendiente'::text)"))
  @@index([status], map: "idx_ar_estado")
}

model badges {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String        @unique @db.VarChar(64)
  descripcion  String?
  icono        String?       @db.VarChar(500)
  color        String?       @db.VarChar(7)
  grant_access Boolean       @default(false)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  user_badges  user_badges[]
}

model creditos_externos {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id String     @db.Uuid
  nombre       String     @db.VarChar(64)
  rol          String     @db.VarChar(64)
  link         String?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  temporadas   temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model creditos_temporada {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id String     @db.Uuid
  user_id      String     @db.Uuid
  rol          String     @db.VarChar(64)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  temporadas   temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([temporada_id, user_id, rol])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model perfil_jugador {
  id                                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id                             String     @db.Uuid
  user_id                                  String?    @db.Uuid
  status                                   String     @default("pendiente") @db.VarChar(12)
  nombre_pj                                String?    @db.VarChar(64)
  edad_pj                                  Int?       @db.SmallInt
  pj_who                                   String?
  historia_pj                              String?
  faccion_pj                               String?    @db.VarChar(64)
  raza_pj                                  String?    @db.VarChar(64)
  clase_pj                                 String?    @db.VarChar(64)
  pregunta_random                          String?
  aprobado_por                             String?    @db.Uuid
  aprobado_en                              DateTime?  @db.Timestamptz(6)
  created_at                               DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                               DateTime?  @db.Timestamptz(6)
  es_npc                                   Boolean    @default(false)
  objetivos                                String?
  reaccion_peligro                         String?
  comida_favorita                          String?    @db.VarChar(255)
  apodo_odiado                             String?    @db.VarChar(255)
  detalles_publicos                        Boolean    @default(false)
  users_perfil_jugador_aprobado_porTousers users?     @relation("perfil_jugador_aprobado_porTousers", fields: [aprobado_por], references: [id], onUpdate: NoAction)
  temporadas                               temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_perfil_jugador_user_idTousers      users?     @relation("perfil_jugador_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([temporada_id, user_id], map: "idx_pp_unico_activo", where: raw("(deleted_at IS NULL)"))
  @@index([status], map: "idx_pp_status")
  @@index([temporada_id], map: "idx_pp_temporada")
  @@index([user_id], map: "idx_pp_user")
}

model season_server_configs {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id    String     @db.Uuid
  server_ip       String?    @db.VarChar(128)
  server_port     Int?       @default(25565) @db.SmallInt
  modpack_url     String?
  modpack_version String?    @db.VarChar(32)
  forge_version   String?    @db.VarChar(32)
  mods_count      Int?
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)
  temporadas      temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model estadisticas_jugador {
  id                            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String?    @db.Uuid
  temporada_id                  String     @db.Uuid
  horas_jugadas                 Decimal    @default(0) @db.Decimal(10, 2)
  kills                         Int        @default(0)
  muertes                       Int        @default(0)
  bloques_colocados              Int        @default(0)
  bloques_rotos                 Int        @default(0)
  distancia_recorrida_km        Decimal    @default(0) @db.Decimal(10, 2)
  actualizado_en                DateTime   @default(now()) @db.Timestamptz(6)
  minecraft_username_pendiente  String?    @db.VarChar(32)
  temporadas                    temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                         users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, temporada_id])
  @@unique([minecraft_username_pendiente, temporada_id], map: "idx_stats_pendiente_unico", where: raw("(user_id IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model temporadas {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero                   Int                     @unique @db.SmallInt
  slug                     String                  @unique @db.VarChar(16)
  nombre                   String                  @db.VarChar(64)
  subtitulo                String?                 @db.VarChar(128)
  status                   String                  @default("proximamente") @db.VarChar(12)
  year                     Int?                    @db.SmallInt
  open_date                DateTime?               @db.Timestamptz(6)
  description              String?
  requires_character_sheet Boolean                 @default(false)
  created_at               DateTime                @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                @default(now()) @db.Timestamptz(6)
  access_requests          access_requests[]
  anuncios                 anuncios[]
  creditos_externos        creditos_externos[]
  creditos_temporada       creditos_temporada[]
  estadisticas_jugador     estadisticas_jugador[]
  perfil_jugador           perfil_jugador[]
  season_mods              season_mods[]
  season_server_configs    season_server_configs[]
  sugerencias              sugerencias[]
}

model user_badges {
  id                                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                             String   @db.Uuid
  badge_id                            String   @db.Uuid
  granted_by                          String?  @db.Uuid
  granted_at                          DateTime @default(now()) @db.Timestamptz(6)
  destacada                           Boolean  @default(false)
  badges                              badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_badges_granted_byTousers users?   @relation("user_badges_granted_byTousers", fields: [granted_by], references: [id], onUpdate: NoAction)
  users_user_badges_user_idTousers    users    @relation("user_badges_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, badge_id])
  @@index([badge_id], map: "idx_ub_badge")
  @@index([user_id], map: "idx_ub_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                                            String               @unique @db.VarChar(32)
  email                                               String?              @unique(map: "idx_users_email", where: raw("(email IS NOT NULL)")) @db.Citext
  password_hash                                       String?
  rol                                                 String               @default("user") @db.VarChar(20)
  minecraft_username                                  String?              @unique @db.VarChar(100)
  discord_id                                          String?              @unique(map: "idx_users_discord_id", where: raw("(discord_id IS NOT NULL)")) @db.VarChar(64)
  discord_tag                                         String?              @db.VarChar(64)
  instagram                                           String?              @db.VarChar(64)
  twitter                                             String?              @db.VarChar(64)
  bio                                                 String?              @db.VarChar(160)
  discord_username                                    String?              @db.VarChar(50)
  deleted_at                                          DateTime?            @db.Timestamptz(6)
  created_at                                          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                          DateTime             @default(now()) @db.Timestamptz(6)
  access_requests_access_requests_revisado_porTousers access_requests[]    @relation("access_requests_revisado_porTousers")
  access_requests_access_requests_user_idTousers      access_requests[]    @relation("access_requests_user_idTousers")
  anuncios                                            anuncios[]
  creditos_temporada                                  creditos_temporada[]
  estadisticas_jugador                                estadisticas_jugador[]
  perfil_jugador_perfil_jugador_aprobado_porTousers   perfil_jugador[]     @relation("perfil_jugador_aprobado_porTousers")
  perfil_jugador_perfil_jugador_user_idTousers        perfil_jugador[]     @relation("perfil_jugador_user_idTousers")
  user_badges_user_badges_granted_byTousers           user_badges[]        @relation("user_badges_granted_byTousers")
  user_badges_user_badges_user_idTousers              user_badges[]        @relation("user_badges_user_idTousers")
  sugerencias                                         sugerencias[]
  sugerencia_votos                                    sugerencia_votos[]

  @@index([deleted_at], map: "idx_users_deleted_at")
  @@index([minecraft_username], map: "idx_users_minecraft")
  @@index([rol], map: "idx_users_rol")
}

model anuncios {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id String     @db.Uuid
  titulo       String     @db.VarChar(128)
  cuerpo       String
  autor_id     String?    @db.Uuid
  pinned       Boolean    @default(false)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  users        users?     @relation(fields: [autor_id], references: [id], onUpdate: NoAction)
  temporadas   temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([temporada_id, created_at(sort: Desc)], map: "idx_anuncios_temporada")
}

model season_mods {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id   String     @db.Uuid
  nombre         String     @db.VarChar(128)
  descripcion    String?
  categoria      String?    @db.VarChar(64)
  icono_url      String?
  modrinth_id    String?    @db.VarChar(64)
  modrinth_url   String?
  curseforge_url String?
  github_url     String?
  version        String?    @db.VarChar(32)
  sort_order     Int?       @default(0)
  archivo_jar    String?    @db.VarChar(255)
  origen         String     @default("manual") @db.VarChar(20)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  temporadas     temporadas @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([temporada_id, sort_order], map: "idx_season_mods_temporada")
}

model sugerencias {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temporada_id          String                 @db.Uuid
  user_id               String?                @db.Uuid
  titulo                String                 @db.VarChar(128)
  descripcion           String
  estado                String                 @default("pendiente") @db.VarChar(20)
  editado               Boolean                @default(false)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  temporadas            temporadas             @relation(fields: [temporada_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                 @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  sugerencia_votos      sugerencia_votos[]
  sugerencia_versiones  sugerencia_versiones[]

  @@index([temporada_id, created_at], map: "idx_sugerencias_temporada")
  @@index([estado], map: "idx_sugerencias_estado")
}

model sugerencia_votos {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sugerencia_id String      @db.Uuid
  user_id       String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  sugerencias   sugerencias @relation(fields: [sugerencia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sugerencia_id, user_id], map: "idx_sv_unico")
}

model sugerencia_versiones {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sugerencia_id String      @db.Uuid
  titulo        String      @db.VarChar(128)
  descripcion   String
  guardado_en   DateTime    @default(now()) @db.Timestamptz(6)
  sugerencias   sugerencias @relation(fields: [sugerencia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sugerencia_id], map: "idx_svers_sugerencia")
}
